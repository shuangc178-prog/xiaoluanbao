    <style name="Theme.CampusLife" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#FAF9F5</item>
        <item name="android:windowBackground">#FAF9F5</item>
        <item name="android:colorAccent">#C6613F</item>
    </style>
</resources>
